NODE_ENV=development
PORT=3000

# Postgres (matches docker-compose.yml when the API runs on your machine)
DATABASE_URL=postgres://shop:shop@localhost:5432/shop
RUN_MIGRATIONS=true

# Auth. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# First admin (used by `npm run seed:admin`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password-now

# Paystack (use your TEST secret key, starts with sk_test_)
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_BASE_URL=https://api.paystack.co
PAYMENT_CALLBACK_URL=http://localhost:3000/payment/callback

# Checkout rules (amounts are in kobo)
ORDER_TTL_MINUTES=30
SHIPPING_FLAT_KOBO=150000
FREE_SHIPPING_OVER_KOBO=5000000

# Set to true to expose Swagger at /docs when NODE_ENV=production
ENABLE_DOCS=false
